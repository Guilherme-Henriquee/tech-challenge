# Porta em que a API vai rodar
PORT=3001

# String de conexao com o MongoDB
# Local (docker-compose): mongodb://mongo:27017/blogdb
# Local (sem docker): mongodb://localhost:27017/blogdb
# Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/blogdb
MONGO_URI=mongodb://localhost:27017/blogdb

# Segredo usado para assinar os tokens JWT (troque em producao!)
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=8h

# Origem permitida para CORS (URL do front-end)
CORS_ORIGIN=http://localhost:5173
